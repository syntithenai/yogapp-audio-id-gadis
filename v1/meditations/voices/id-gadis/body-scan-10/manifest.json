    },
    {
      "index": 15,
      "text": "[jeda:27]",
      "file": "c015.ogg",
      "durationSec": 4.92
    },
    {
      "index": 16,
      "text": "Dahi. Mata. Pipi. Rahang.",
      "file": "c016.ogg",
      "durationSec": 11.328
    },
    {
      "index": 17,
      "text": "Biarkan wajah sedikit meleleh.",
      "file": "c017.ogg",
      "durationSec": 5.592
    },
    {
      "index": 18,
      "text": "[jeda:27]",
      "file": "c018.ogg",
      "durationSec": 4.92
    },
    {
      "index": 19,
      "text": "Tenggorokan. Leher. Bahu.",
      "file": "c019.ogg",
      "durationSec": 9.696
    },
    {
      "index": 20,
      "text": "Undang bahu untuk turun.",
      "file": "c020.ogg",
      "durationSec": 4.968
    },
    {
      "index": 21,
      "text": "[jeda:32]",
      "file": "c021.ogg",
      "durationSec": 5.256
    },
    {
      "index": 22,
      "text": "Lengan. Siku. Pergelangan tangan. Tangan. Jari.",
      "file": "c022.ogg",
      "durationSec": 15.216
    },
    {
      "index": 23,
      "text": "[jeda:32]",
      "file": "c023.ogg",
      "durationSec": 5.256
    },
    {
      "index": 24,
      "text": "Dada naik turun.",
      "file": "c024.ogg",
      "durationSec": 4.128
    },
    {
      "index": 25,
      "text": "Ruang jantung melunak.",
      "file": "c025.ogg",
