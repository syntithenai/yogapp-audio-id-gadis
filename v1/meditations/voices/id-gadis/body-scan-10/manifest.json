    },
    {
      "index": 26,
      "text": "[jeda:27]",
      "file": "c026.ogg",
      "durationSec": 4.92
    },
    {
      "index": 27,
      "text": "Perut. Punggung bawah. Pinggul.",
      "file": "c027.ogg",
      "durationSec": 8.904
    },
    {
      "index": 28,
      "text": "[jeda:32]",
      "file": "c028.ogg",
      "durationSec": 5.256
    },
    {
      "index": 29,
      "text": "Paha. Lutut. Betis. Pergelangan kaki. Kaki. Jari kaki.",
      "file": "c029.ogg",
      "durationSec": 18.312
    },
    {
      "index": 30,
      "text": "[jeda:38]",
      "file": "c030.ogg",
      "durationSec": 5.664
    },
    {
      "index": 31,
      "text": "Rasakan seluruh tubuh sebagai satu bidang.",
      "file": "c031.ogg",
      "durationSec": 7.032
    },
    {
      "index": 32,
      "text": "Nafas bergerak melaluinya.",
