    },
    {
      "index": 9,
      "text": "[jeda:21]",
      "file": "c009.ogg",
      "durationSec": 4.728
    },
    {
      "index": 10,
      "text": "Biarkan bahu turun.",
      "file": "c010.ogg",
      "durationSec": 4.464
    },
    {
      "index": 11,
      "text": "Biarkan perut melunak.",
      "file": "c011.ogg",
