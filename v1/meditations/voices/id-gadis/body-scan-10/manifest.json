    },
    {
      "index": 38,
      "text": "[jeda:32]",
      "file": "c038.ogg",
      "durationSec": 5.256
    },
    {
      "index": 39,
      "text": "Mulai dalamkan pernapasan.",
      "file": "c039.ogg",
      "durationSec": 5.184
    },
    {
      "index": 40,
      "text": "Rasakan ruangan lagi.",
      "file": "c040.ogg",
      "durationSec": 4.68
    },
    {
      "index": 41,
      "text": "Goyangkan jari tangan dan kaki.",
