      "durationSec": 5.136
    },
    {
      "index": 33,
      "text": "[jeda:54]",
      "file": "c033.ogg",
      "durationSec": 4.896
    },
    {
      "index": 34,
      "text": "Jika ada bagian yang masih tegang, hembuskan nafas ke sana.",
      "file": "c034.ogg",
      "durationSec": 8.976
    },
    {
      "index": 35,
      "text": "[jeda:43]",
      "file": "c035.ogg",
      "durationSec": 5.376
    },
    {
      "index": 36,
      "text": "Beristirahat dalam kesadaran seluruh tubuh.",
      "file": "c036.ogg",
      "durationSec": 6.624
    },
    {
      "index": 37,
      "text": "[jeda:81]",
