      "durationSec": 1.56
    },
    {
      "index": 3,
      "text": "Tutup mata jika terasa aman.",
      "file": "c003.ogg",
      "durationSec": 5.592
    },
    {
      "index": 4,
      "text": "Rasakan kontak dengan tanah.",
      "file": "c004.ogg",
