    },
    {
      "index": 12,
      "text": "[jeda:27]",
      "file": "c012.ogg",
      "durationSec": 4.92
    },
    {
      "index": 13,
      "text": "Mulai dari puncak kepala.",
      "file": "c013.ogg",
      "durationSec": 5.04
    },
    {
      "index": 14,
      "text": "Perhatikan sensasi, atau kurangnya sensasi.",
      "file": "c014.ogg",
