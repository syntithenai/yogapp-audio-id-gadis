    {
      "index": 0,
      "text": "Selamat datang.",
      "file": "c000.ogg",
      "durationSec": 3.984
    },
    {
      "index": 1,
      "text": "Temukan posisi duduk yang nyaman, atau berbaring jika terasa lebih baik.",
      "file": "c001.ogg",
      "durationSec": 10.44
    },
    {
      "index": 2,
      "text": "Biarkan tangan beristirahat.",
      "file": "c002.ogg",
      "durationSec": 4.944
    },
    {
      "index": 3,
      "text": "Lemaskan mata, atau tutuplah.",
      "file": "c003.ogg",
      "durationSec": 6.432
    },
    {
      "index": 4,
      "text": "Ambil napas perlahan masuk.",
      "file": "c004.ogg",
      "durationSec": 4.824
    },
    {
      "index": 5,
      "text": "Dan napas keluar yang lebih panjang.",
      "file": "c005.ogg",
      "durationSec": 5.664
    },
    {
      "index": 6,
      "text": "Rasakan tulang duduk, atau kaki.",
      "file": "c006.ogg",
      "durationSec": 6.552
    },
    {
      "index": 7,
      "text": "Dasar yang stabil di bawah Anda.",
