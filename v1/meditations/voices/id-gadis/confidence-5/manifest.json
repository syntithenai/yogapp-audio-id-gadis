    },
    {
      "index": 25,
      "text": "[jeda:28]",
      "file": "c025.ogg",
      "durationSec": 5.064
    },
    {
      "index": 26,
      "text": "Ambil satu napas lagi dengan mudah.",
      "file": "c026.ogg",
      "durationSec": 6.312
