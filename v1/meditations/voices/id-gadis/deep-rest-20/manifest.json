  "chunks": [
    {
      "index": 0,
      "text": "Selamat datang di praktik istirahat mendalam.",
      "file": "c000.ogg",
      "durationSec": 6.888
    },
    {
      "index": 1,
      "text": "Berbaringlah telentang jika memungkinkan.",
      "file": "c001.ogg",
      "durationSec": 6.312
    },
    {
      "index": 2,
