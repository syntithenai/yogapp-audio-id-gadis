      "text": "[jeda:55]",
      "file": "c074.ogg",
      "durationSec": 4.992
    },
    {
      "index": 75,
      "text": "Istirahat di sini.",
      "file": "c075.ogg",
      "durationSec": 4.272
    },
    {
      "index": 76,
      "text": "Tidak ada yang perlu diselesaikan.",
      "file": "c076.ogg",
      "durationSec": 5.64
    },
    {
      "index": 77,
      "text": "Tidak ada yang perlu diperbaiki.",
