      "text": "Ambil napas yang lebih dalam.",
      "file": "c095.ogg",
      "durationSec": 5.112
    },
    {
      "index": 96,
      "text": "Dan hembuskan napas panjang.",
      "file": "c096.ogg",
      "durationSec": 0.72
    },
    {
      "index": 97,
      "text": "Ketika Anda siap, buka mata.",
