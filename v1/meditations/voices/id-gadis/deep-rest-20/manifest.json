      "index": 10,
      "text": "[jeda:23]",
      "file": "c010.ogg",
      "durationSec": 4.824
    },
    {
      "index": 11,
      "text": "Perhatikan napas alami.",
      "file": "c011.ogg",
      "durationSec": 5.28
    },
    {
      "index": 12,
      "text": "Tidak perlu mengubahnya.",
      "file": "c012.ogg",
      "durationSec": 4.488
    },
    {
      "index": 13,
      "text": "Napas masuk.",
      "file": "c013.ogg",
      "durationSec": 3.504
    },
    {
      "index": 14,
      "text": "Napas keluar.",
      "file": "c014.ogg",
