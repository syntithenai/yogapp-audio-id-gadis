    },
    {
      "index": 15,
      "text": "[jeda:25]",
      "file": "c015.ogg",
      "durationSec": 4.8
    },
    {
      "index": 16,
      "text": "Jika pikiran sibuk, itu diperbolehkan.",
      "file": "c016.ogg",
      "durationSec": 7.32
    },
    {
      "index": 17,
      "text": "Kamu tetap bisa beristirahat.",
      "file": "c017.ogg",
      "durationSec": 5.304
    },
    {
      "index": 18,
      "text": "Kembalilah ke sensasi secara terus-menerus.",
