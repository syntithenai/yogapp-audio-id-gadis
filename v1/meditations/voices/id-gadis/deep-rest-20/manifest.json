      "file": "c002.ogg",
      "durationSec": 6.504
    },
    {
      "index": 3,
      "text": "Biarkan lengan beristirahat di sisi tubuh, telapak tangan rileks.",
      "file": "c003.ogg",
      "durationSec": 9.6
    },
    {
      "index": 4,
      "text": "Tutup mata.",
      "file": "c004.ogg",
      "durationSec": 3.456
    },
    {
      "index": 5,
      "text": "Tidak ada tempat lain untuk berada.",
