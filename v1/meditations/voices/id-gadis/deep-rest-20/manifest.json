      "durationSec": 5.472
    },
    {
      "index": 78,
      "text": "[jeda:110]",
      "file": "c078.ogg",
      "durationSec": 5.28
    },
    {
      "index": 79,
      "text": "Jika kamu terbawa, itu tidak apa-apa.",
      "file": "c079.ogg",
      "durationSec": 7.296
    },
    {
      "index": 80,
      "text": "Jika kamu tetap sadar, itu juga baik.",
      "file": "c080.ogg",
      "durationSec": 7.056
    },
    {
      "index": 81,
      "text": "Keduanya adalah istirahat.",
