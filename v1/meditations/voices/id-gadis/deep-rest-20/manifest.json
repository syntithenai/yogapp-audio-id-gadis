      "index": 6,
      "text": "[jeda:23]",
      "file": "c006.ogg",
      "durationSec": 4.824
    },
    {
      "index": 7,
      "text": "Rasakan titik-titik kontak dengan lantai atau tempat tidur.",
      "file": "c007.ogg",
      "durationSec": 8.424
    },
    {
      "index": 8,
      "text": "Tumit. Pinggul. Tulang belikat. Kepala.",
      "file": "c008.ogg",
      "durationSec": 11.448
    },
    {
      "index": 9,
      "text": "Biarkan tubuh didukung.",
