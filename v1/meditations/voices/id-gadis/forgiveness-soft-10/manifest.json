      "durationSec": 5.448
    },
    {
      "index": 25,
      "text": "Saya melepaskan apa yang bisa saya lepaskan.",
      "file": "c025.ogg",
      "durationSec": 7.32
    },
    {
      "index": 26,
      "text": "Saya menjaga batas saya. Saya meletakkan beban berlebih.",
      "file": "c026.ogg",
      "durationSec": 10.752
    },
    {
      "index": 27,
      "text": "[jeda:54]",
      "file": "c027.ogg",
      "durationSec": 4.896
    },
    {
