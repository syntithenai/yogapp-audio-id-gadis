    },
    {
      "index": 11,
      "text": "Turunkan bahu menjauh dari telinga.",
      "file": "c011.ogg",
      "durationSec": 6.216
    },
    {
      "index": 12,
      "text": "Bayangkan hari ini menetap seperti debu setelah angin berhembus.",
      "file": "c012.ogg",
      "durationSec": 8.784
    },
    {
      "index": 13,
      "text": "Apa yang terjadi, telah terjadi.",
