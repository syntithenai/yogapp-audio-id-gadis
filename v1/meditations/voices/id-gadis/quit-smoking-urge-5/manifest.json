    },
    {
      "index": 31,
      "text": "[jeda:18]",
      "file": "c031.ogg",
      "durationSec": 4.752
    },
    {
      "index": 32,
      "text": "Lagi. Tarik napas lembut.",
      "file": "c032.ogg",
      "durationSec": 6.888
    },
    {
      "index": 33,
      "text": "Ekspulsikan lebih lama.",
      "file": "c033.ogg",
      "durationSec": 4.848
    },
    {
      "index": 34,
      "text": "[jeda:16]",
      "file": "c034.ogg",
      "durationSec": 5.04
    },
    {
      "index": 35,
      "text": "Perhatikan apakah ada rasa lega, bahkan sedikit.",
      "file": "c035.ogg",
      "durationSec": 8.232
    },
    {
      "index": 36,
      "text": "Atau perhatikan bahwa Anda tetap bersama diri sendiri.",
      "file": "c036.ogg",
      "durationSec": 8.04
    },
    {
      "index": 37,
      "text": "Keduanya dihitung.",
