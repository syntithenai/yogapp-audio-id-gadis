    },
    {
      "index": 38,
      "text": "[jeda:16]",
      "file": "c038.ogg",
      "durationSec": 5.04
    },
    {
      "index": 39,
      "text": "Anda adalah seorang non-perokok yang bertemu dengan gema lama.",
      "file": "c039.ogg",
      "durationSec": 8.184
    },
    {
      "index": 40,
      "text": "Godaan bisa datang. Ia tidak bisa menguasai Anda.",
