    },
    {
      "index": 1,
      "text": "Cari posisi duduk yang nyaman, atau berbaring jika itu terasa lebih baik.",
      "file": "c001.ogg",
      "durationSec": 10.464
    },
    {
      "index": 2,
      "text": "Biarkan tangan tetap rileks.",
      "file": "c002.ogg",
