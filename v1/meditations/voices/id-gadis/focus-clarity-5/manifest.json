    {
      "index": 5,
      "text": "Dan hembuskan napas lebih lama.",
      "file": "c005.ogg",
      "durationSec": 5.64
    },
    {
      "index": 6,
      "text": "Pilih satu titik fokus. Napas di hidung, atau kenaikan perut.",
      "file": "c006.ogg",
      "durationSec": 11.52
    },
    {
