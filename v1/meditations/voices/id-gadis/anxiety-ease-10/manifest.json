      "durationSec": 7.968
    },
    {
      "index": 44,
      "text": "[jeda:41]",
      "file": "c044.ogg",
      "durationSec": 5.28
    },
    {
      "index": 45,
      "text": "[jeda:30]",
      "file": "c045.ogg",
      "durationSec": 4.56
    },
    {
      "index": 46,
      "text": "Mulai dalamkan napas.",
      "file": "c046.ogg",
      "durationSec": 4.68
    },
    {
      "index": 47,
      "text": "Rasakan ruangan lagi.",
      "file": "c047.ogg",
      "durationSec": 4.68
    },
    {
      "index": 48,
      "text": "Goyangkan jari tangan dan kaki.",
      "file": "c048.ogg",
      "durationSec": 5.784
