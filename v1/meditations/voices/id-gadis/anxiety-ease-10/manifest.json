    },
    {
      "index": 2,
      "text": "Duduk atau berbaring dengan dukungan.",
      "file": "c002.ogg",
      "durationSec": 6.192
    },
    {
      "index": 3,
      "text": "Tutup mata jika itu terasa aman.",
      "file": "c003.ogg",
      "durationSec": 6.024
    },
    {
      "index": 4,
      "text": "Rasakan kontak dengan tanah.",
      "file": "c004.ogg",
